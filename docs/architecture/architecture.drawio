          </mxGeometry>
        </mxCell>
        <mxCell id="stateless-note-1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;슬롯 SO가 무상태가 아니면 생기는 일&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SO 에셋은 게임 전체에 하나뿐이라, 같은 스킬을 쓰는 몬스터 · 플레이어가 모두 같은 객체를 공유한다.&lt;br&gt;여기에 &quot;지금 노리는 대상&quot;, &quot;마지막 명중 위치&quot; 같은 값을 저장하면 다른 시전자가 같은 칸을 덮어써서, 엉뚱한 대상에게 피해가 가거나 폭발 위치가 어긋난다.&lt;br&gt;투사체는 도착을 기다리는(await) 동안 다른 시전자나 같은 시전자의 다음 발이 값을 덮어쓸 수 있어서, 연사도 안 된다.&lt;br&gt;그래서 값은 시전마다 새로 만드는 SkillContext에 담는다. 예: 폭발 중심은 ctx.SetEpicenter(...)로 전달한다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="198" width="420" x="1200" y="714" as="geometry" />
        </mxCell>
        <mxCell id="rcArosuYG4XdXFg1hASv-1" edge="1" parent="1" source="c52" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;defaultLabelBackgroundColor=page;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="c61" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="880" y="1930" as="sourcePoint" />
            <mxPoint x="930" y="1880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rcArosuYG4XdXFg1hASv-3" edge="1" parent="1" source="c60" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;defaultLabelBackgroundColor=page;entryX=0.526;entryY=0.99;entryDx=0;entryDy=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryPerimeter=0;" target="c52" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="600" y="1700" as="sourcePoint" />
            <mxPoint x="532.5000000000005" y="1589.0000000000005" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      <mxCell id="dd34" value="클라이언트 (표현)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="2841" width="1620" height="232" as="geometry"/></mxCell>
<mxCell id="dd21" value="서버 (판정 권위)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;fillOpacity=35;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="2203" width="1620" height="568" as="geometry"/></mxCell>
<mxCell id="dd11" value="클라이언트 (입력)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="1954" width="1620" height="179" as="geometry"/></mxCell>
<mxCell id="dd10" value="&lt;b style=&quot;font-size:13px&quot;&gt;PlayerAttackController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;홀드 시작: CmdBeginAim()으로 서버에 조준 시작을 알린다 (게이지는 서버가 직접 잰다)&lt;br&gt;발사 프레임(ReleaseArrow): ① CmdRequestShoot(origin, direction) 호출  ② 순수 클라이언트면 손에 든 화살로 표현 화살을 직접 띄운다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="2010" width="760" height="99" as="geometry"/></mxCell>
<mxCell id="dd12" value="&lt;b style=&quot;font-size:13px&quot;&gt;ProjectilePool&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Rent(): (프리팹 × 씬) 단위 풀에서 대여. 씬이 내려가면 그 풀도 함께 정리&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="2259" width="280" height="82" as="geometry"/></mxCell>
<mxCell id="dd13" value="&lt;b style=&quot;font-size:13px&quot;&gt;NetworkProjectileRelay  [NetworkBehaviour]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;RpcConfirmHit(): 명중 지점을 클라에 알린다. 호출은 ProjectileRequest의 OnResolved 콜백에 꽂혀 있다 (Projectile은 네트워크를 모른다)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="2259" width="280" height="134" as="geometry"/></mxCell>
<mxCell id="dd14" value="&lt;b style=&quot;font-size:13px&quot;&gt;PlayerAttackAuthority&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CmdRequestShoot(): 요청을 검증하고 발사 정보(ProjectileRequest)를 만든다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="2453" width="280" height="82" as="geometry"/></mxCell>
<mxCell id="dd15" value="&lt;b style=&quot;font-size:13px&quot;&gt;ProjectileRequest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;데이터 묶음(struct). 원점 · 방향 · 속도 · 충돌 반경 · 마스크 · 유도 대상 · OnResolved 콜백 등 발사에 필요한 값. 함수(동작)는 없다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="2453" width="280" height="115" as="geometry"/></mxCell>
<mxCell id="dd16" value="&lt;b style=&quot;font-size:13px&quot;&gt;SkillDefinition : ISkill&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Execute(): ① 축2 ProjectileCastSO가 발사를 시작하고, 도착(명중 · 소멸)까지 await로 기다린다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="2453" width="280" height="99" as="geometry"/></mxCell>
<mxCell id="dd17" value="&lt;b style=&quot;font-size:13px&quot;&gt;ProjectileLauncher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Launch(): 화살을 확보하고(손 화살, 없으면 풀에서 대여) Projectile.Launch를 부른다. 서버면 판정 모드(Authoritative)로 발사&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="2453" width="280" height="115" as="geometry"/></mxCell>
<mxCell id="dd18" value="&lt;b style=&quot;font-size:13px&quot;&gt;Projectile (서버)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Update마다 이번 이동 구간을 SphereCast로 훑는다. 명중 · 벽 · 수명 초과면 Resolve()로 끝내고 풀에 반납&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="2453" width="280" height="99" as="geometry"/></mxCell>
<mxCell id="dd19" value="&lt;b style=&quot;font-size:13px&quot;&gt;SkillDefinition : ISkill (재개)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;await가 끝나면 명중 대상(없으면 빈 목록)으로 후보를 교체하고, ② 축1 대상 선택 → ③ 축3 DamageEffect를 실행&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="2648" width="280" height="99" as="geometry"/></mxCell>
<mxCell id="dd20" value="&lt;b style=&quot;font-size:13px&quot;&gt;Health : IDamageable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;TakeDamage(power, 시전자): 체력 감소. 명중 대상이 없으면 아무 일도 일어나지 않는다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="2648" width="280" height="99" as="geometry"/></mxCell>
<mxCell id="dd22" value="[Command]&lt;br&gt;CmdRequestShoot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.41;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd10" target="dd14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dd14" target="dd15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dd15" target="dd16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dd16" target="dd17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd26" value="Launch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dd17" target="dd18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd27" value="Rent() 호출&lt;br&gt;(화살 대여)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd17" target="dd12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd28" value="명중했을 때만&lt;br&gt;OnResolved 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd18" target="dd13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd29" value="HitTask 완료&lt;br&gt;(명중: 대상 / 그 외: 없음)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd18" target="dd19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd30" value="대상이 있으면&lt;br&gt;TakeDamage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd19" target="dd20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd31" value="&lt;b style=&quot;font-size:13px&quot;&gt;표현용 Projectile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;판정 없이 날아가기만 한다 (Presentation 모드)&lt;br&gt;플레이어 화살은 위 PlayerAttackController가 직접 띄우고, 몬스터 화살은 서버가 RpcLaunchPresentation으로 알려 띄운다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="2897" width="380" height="115" as="geometry"/></mxCell>
<mxCell id="dd32" value="&lt;b style=&quot;font-size:13px&quot;&gt;명중했을 때&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;서버가 RpcConfirmHit(지점)을 보낸다 → ForceResolveAt(): 화살촉을 그 지점으로 옮기고 바로 풀에 반납&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="2897" width="1000" height="66" as="geometry"/></mxCell>
<mxCell id="dd33" value="&lt;b style=&quot;font-size:13px&quot;&gt;빗나갔을 때 · 벽에 막혔을 때 · 수명 초과&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;서버는 알림을 보내지 않는다 → 클라 화살은 계속 날다가 자기 수명(MaxLifetime)이 끝나면 풀에 반납. 벽에 막혀도 화면에서는 수명까지 날아간다&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="2983" width="1000" height="66" as="geometry"/></mxCell>
<mxCell id="dd35" value="서버가 명중을 알림" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd31" target="dd32"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd36" value="알림 없음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd31" target="dd33"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd37" value="[ClientRpc] RpcConfirmHit (명중 시에만)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.93;exitY=1;exitDx=0;exitDy=0;entryX=0.93;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd21" target="dd34"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="dd38" value="&lt;b style=&quot;font-size:13px&quot;&gt;애니메이션 이벤트 이름 = 컴포넌트 간 암묵적 계약&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;OnAttackNock / OnAttackRelease / OnAttackHit (AnimationEventReceiver). 플레이어와 스켈레톤 궁수가 같은 클립을 쓴다.&lt;br&gt;이름을 바꾸면 컴파일 에러 없이 한쪽이 조용히 죽는다.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3113" width="1620" height="82" as="geometry"/></mxCell>
<mxCell id="dd-return" value="ReturnToPool() 호출&lt;br&gt;(반납)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd18" target="dd12"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. 어셈블리 구조" id="page6">
    <mxGraphModel dx="2035" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c39" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fillOpacity=35;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;" value="" vertex="1">
          <mxGeometry height="106" width="1424" x="238" y="1096" as="geometry" />
        </mxCell>
        <mxCell id="c31" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fillOpacity=35;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;" value="" vertex="1">
          <mxGeometry height="139" width="1424" x="238" y="911" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fillOpacity=35;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;" value="" vertex="1">
          <mxGeometry height="106" width="1424" x="238" y="759" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;" value="어셈블리(asmdef) 분리 — 참조는 위에서 아래로만" vertex="1">
          <mxGeometry height="44" width="1500" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" value="7 · 조립 루트" vertex="1">
          <mxGeometry height="26" width="190" x="40" y="86" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;MySecondWorld.LifetimeScope&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;모든 DI 스코프(Project · Player · NPCLifetime · NPCScope · AIModelDownload)를 등록하는 곳. 가장 많은 어셈블리를 참조하는 조립 전용 어셈블리.&lt;/span&gt;" vertex="1">
