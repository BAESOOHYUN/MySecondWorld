        <mxCell id="c15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;저장 (클라이언트)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CharacterSaveService: 캐릭터 외형을 PlayerPrefs에 계정별로 저장&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="340" x="60" y="485" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;리소스 로드 · 캐시 (클라이언트)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;AddressablesService (번들 · 씬 로드)&lt;br&gt;WebResourceService (L1 메모리 → L2 디스크 → L3 네트워크 캐시)&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="340" x="60" y="581" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;입력 · 카메라&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;New Input System&lt;br&gt;Cinemachine 3인칭 카메라&lt;br&gt;TouchEventListener · TapTargetResolver (탭 타겟팅)&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="340" x="410" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;전투 (클라이언트)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PlayerAttackController (홀드 게이지 조준)&lt;br&gt;ProjectileLauncher · ProjectilePool&lt;br&gt;IHealthView (HP바 통합)&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="340" x="410" y="259" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;커스터마이징 · 인벤토리&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ObservableCharacterCustomizer&lt;br&gt;CharacterAppearanceSO (파츠 키 테이블)&lt;br&gt;Cleverous Vault 인벤토리 + 장비 연동&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="340" x="410" y="372" as="geometry" />
        </mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;공유 스크린&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SharedScreenController&lt;br&gt;FileChunkSender (청크 전송) · PDF 렌더링&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="340" x="410" y="485" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;VContainer + MessagePipe + UniTask&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;스코프 계층 DI · 키 기반 이벤트 버스 · 비동기(취소 토큰)&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="690" x="60" y="694" as="geometry" />
        </mxCell>
        <mxCell id="c23" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;GameNetworkManager  [Mirror NetworkManager 상속]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mirror의 서버/클라 진입점. 서버 시작·종료와 접속/퇴장 콜백을 받고, 메시지 핸들러(NetworkServer.RegisterHandler)를 등록한 뒤 아래 서비스들을 만들어 연결한다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="520" x="920" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;PlayerAuthenticator  [Mirror NetworkAuthenticator 상속]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;접속 직후 클라가 보낸 인증 요청(이름·비밀번호)을 받아 통과(ServerAccept) 또는 차단(ServerReject)한다. 인증 전 연결은 게임에 못 들어온다.&lt;br&gt;PasswordCredentialStore: 기존 계정 Verify / 신규 Register, PBKDF2 (HMAC-SHA256, 10만회)&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="520" x="920" y="243" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;ServerSessionService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;접속한 연결(conn)마다 PlayerSession을 들고 있는 세션 관리자.&lt;br&gt;접속: 세이브 로드 → 클라에 씬 로드 지시 → 로드 ACK 후 캐릭터를 NetworkServer.Spawn → 컴패니언 복원 · 시작 아이템 지급&lt;br&gt;퇴장: 위치·씬을 SaveManager로 saves/{id}.json에 저장하고 세션 정리&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="520" x="920" y="372" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;ServerZoneService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;어느 플레이어가 어느 씬(존)에 있는지 추적하고, 경계·포탈에 따라 Additive 씬 로드/언로드를 지시한다.&lt;br&gt;CheckZones / CheckPortals 폴링 · 낙하 복구 · 방의 matchId 갱신(가시성 범위)&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="520" x="920" y="501" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;DungeonRoomRegistry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;던전 씬별 방 배정 (기본 정원 4, 인스펙터에서 조정) · 방 열림/닫힘 이벤트&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="520" x="920" y="614" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;전투 (서버)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MonsterAI · BossAI · MonsterWaveSpawner&lt;br&gt;PlayerAttackAuthority: 클라 요청을 검증해 발사 · 명중 판정&lt;br&gt;Health(IDamageable)로 피해 적용&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="520" x="920" y="694" as="geometry" />
        </mxCell>
        <mxCell id="c29" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;NPC 상태 (서버)  [NPCServerState · NetworkBehaviour]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;NPC의 생존 · 퀘스트 단계 · 진영 관계를 [SyncVar]로 모든 클라에 동기화. 서버만 값을 바꾼다. NPCBrain이 읽어 LLM 프롬프트에 반영한다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="520" x="920" y="807" as="geometry" />
        </mxCell>
        <mxCell id="c30" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;컴패니언 상태 (서버)  [CompanionServerState · NetworkBehaviour]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;컴패니언의 HP · 생존 · 소환 여부 · 주인(netId)을 [SyncVar]로 동기화하고, 값이 바뀌면 훅으로 클라 HP바를 갱신한다. 소환 해제와 생사는 별개 상태.&lt;/span&gt;" vertex="1">
          <mxGeometry height="101" width="520" x="920" y="903" as="geometry" />
        </mxCell>
        <mxCell id="c31" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;저장 (서버)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SaveManager: 플레이어별 JSON(saves/{id}.json)에 위치 · 씬 · 컴패니언 등을 저장 · 복원&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="520" x="920" y="1018" as="geometry" />
        </mxCell>
        <mxCell id="c34" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFE6CC;fillOpacity=35;strokeColor=#D79B00;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=16;" value="외부 서비스 · 온디바이스" vertex="1">
          <mxGeometry height="190" width="1420" x="40" y="1194" as="geometry" />
        </mxCell>
        <mxCell id="c35" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Groq Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;LLM: qwen/qwen3.8-27b (스트리밍)&lt;br&gt;STT: Whisper (HTTPS POST)&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="320" x="70" y="1244" as="geometry" />
        </mxCell>
        <mxCell id="c36" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Microsoft Edge TTS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;NativeWebSocket → MP3 → AudioClip&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="320" x="420" y="1244" as="geometry" />
        </mxCell>
        <mxCell id="c37" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Addressables 원격 호스팅&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;카탈로그 + 번들 (필드 · 던전 씬, 파츠)&lt;br&gt;클라는 시작 시 번들 동기화&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="320" x="770" y="1244" as="geometry" />
        </mxCell>
