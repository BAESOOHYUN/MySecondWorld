        <mxCell id="c21" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;중심에서 멀수록 약한 피해&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SplashDamageEffect&lt;br&gt;(중심 100% → 반경 끝 0%)&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="260" x="820" y="504" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;dashed=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;확장 예시 (미구현)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;도트 피해 · 힐 · 버프/디버프&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="260" x="820" y="598" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;dashed=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;ComboSkill (확장 예정, 미구현)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ISkill을 구현해서 단일 스킬(SkillDefinition)과 콤보를 같은 타입으로 다루려는 자리. Composite 패턴.&lt;br&gt;지금 코드에는 ComboSkill 클래스가 없고, ISkill 계약만 먼저 만들어 두었다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="1040" x="60" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#666666;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="12" width="12" x="574" y="260" as="geometry" />
        </mxCell>
