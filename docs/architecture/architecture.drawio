        <mxCell id="c11" value="&lt;b style=&quot;font-size:13px&quot;&gt;NPCInteractable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Stateless 상태 머신&lt;br&gt;상태: Idle · InRange · Menu(대화/상점 선택) · Talking · Generating&lt;br&gt;근접 시 힌트 UI, 상호작용 시 대화창 오픈&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
