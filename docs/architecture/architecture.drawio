        <mxCell id="1" parent="0" />
        <mxCell id="c10" value="VContainer LifetimeScope 계층" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:13px&quot;&gt;ProjectLifetimeScope — 앱 전체 (최상위)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Singleton: SaveManager · CharacterSaveService · CharacterAppearanceService · PasswordCredentialStore&lt;br&gt;Singleton: WebResourceService + 메모리 캐시 2종 + DiskCacheService · AddressablesService(EntryPoint)&lt;br&gt;Singleton: IDeviceCapability → NetworkDeviceCapability(서버 모드) / LocalDeviceCapability(로컬 모드)&lt;br&gt;Component: GameNetworkManager · PlayerAuthenticator · UIManager · LoginUI · MenuUI · ChatUI · InventoryUI · TapTargetResolver&lt;br&gt;MessageBroker: AuthStateChanged · CharacterAppearanceSaved/SyncRequested · RequestOpenCustomizeUI · AddressablesProgress&lt;br&gt;헤드리스 서버 빌드: UI 전부 제외하고 NullUIManager만 등록 (#if UNITY_SERVER)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="840" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b style=&quot;font-size:13px&quot;&gt;PlayerScope — Mirror가 스폰하는 플레이어 프리팹&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Component: MovementController · PlayerAnimationController&lt;br&gt;Component: ThirdPersonCameraController · ObservableCharacterCustomizer&lt;br&gt;Component: NetworkCharacterAppearance · NetworkPlayerController&lt;br&gt;Component: NetworkInventoryActions · NetworkWeaponEquip · PlayerHealthState&lt;br&gt;MessageBroker: PlayerJumped / Falled / Landed / SpeedChanged · CharacterAppearanceChanged&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="430" height="198" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:13px&quot;&gt;AIModelDownloadLifetimeScope&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;OpenWorldRobby 씬&lt;br&gt;AIModelDownloader · AIModelDownloadStarter(EntryPoint)&lt;br&gt;AIModelDownloadUI&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="335" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b style=&quot;font-size:13px&quot;&gt;NPCLifetimeScope — 대화 인프라 (MainScene)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MessageBroker&amp;lt;string, PlayerMessageSentEvent&amp;gt; (키 = NPC GUID)&lt;br&gt;NPCResponseReceived · NPCThinkingStarted · NPCDialogue · NPCTTSSentence · NPCStopTTS · NPCSpeakFinished · NPCSentenceStarted&lt;br&gt;ISTTService: GroqWhisperSTTService / WhisperSTTService — 마이크가 기기당 1개라 공유 스코프에 등록&lt;br&gt;INPCDialogueUI: 대화창 단일 인스턴스를 NPC 전체가 공유&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="335" width="640" height="148" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:13px&quot;&gt;NPCScope — NPC 프리팹마다 하나&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;FindParent()가 Find&amp;lt;NPCLifetimeScope&amp;gt;()로 부모를 찾음 (서브씬에 로드되는 프리팹이라)&lt;br&gt;Component: NPCBrain · NPCInteractable · NPCVoicePlayer · NPCLipSyncController · NPCCharacterCustomizer&lt;br&gt;ILLMService: GroqLLMService(Scoped) / LocalLLMService — 부모의 IDeviceCapability.UseServerMode로 분기&lt;br&gt;ITTSService: EdgeTTSServiceNativeWebSocket · NPC별 CharacterAppearanceSO · NPCSystemPromptSO&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="553" width="640" height="148" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Parent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="Parent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="Parent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="Parent (FindParent)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b style=&quot;font-size:13px&quot;&gt;스코프 규칙&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;자식 스코프는 부모에 등록된 것을 주입받을 수 있다. 부모는 자식 것을, 형제 스코프끼리는 서로 볼 수 없다.&lt;br&gt;서버와 클라이언트가 모두 만드는 스코프(PlayerScope 등)에는 한쪽 전용 객체를 [Inject]하면 안 된다.&lt;br&gt;→ 한쪽에서 Resolve 실패하면 스코프 전체가 무너진다 (서버/클라 양방향으로 실제 재발한 버그).&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="583" width="760" height="99" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b style=&quot;font-size:13px&quot;&gt;구현체 분기 지점&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;IDeviceCapability.UseServerMode 하나로 LLM · STT 구현체를 교체한다 (호출부는 인터페이스만 안다).&lt;br&gt;ProjectLifetimeScope가 플래그를 정하고 → NPCLifetimeScope(STT) · NPCScope(LLM)가 부모에서 읽어 등록한다.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="733" width="760" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
