        </mxCell>
        <mxCell id="c14" value="&lt;b style=&quot;font-size:13px&quot;&gt;MessagePipe 이벤트 버스&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PlayerMessageSentEvent (키 = NPC GUID → NPC마다 독립 채널)&lt;br&gt;NPCThinkingStarted · NPCResponseReceived&lt;br&gt;NPCTTSSentence · NPCStopTTS · NPCSpeakFinished&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
