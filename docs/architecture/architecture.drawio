        <mxCell id="c27" value="C. 던전 방 인스턴싱 (같은 던전 씬 = 방 여러 개)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1">
