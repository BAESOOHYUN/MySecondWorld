        <mxCell id="c39" edge="1" parent="1" source="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" target="c33" value="Mirror:&amp;nbsp;&lt;div&gt;클라 → 서버 [Command] 요청&amp;nbsp;&lt;/div&gt;&lt;div&gt;서버 → 클라 [SyncVar] · [ClientRpc] 동기화&lt;/div&gt;">
