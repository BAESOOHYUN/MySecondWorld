          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;b style=&quot;font-size:13px&quot;&gt;설계 메모 1 — 호출 순서&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;matchId를 먼저 세팅하고 NotifyRoomOpened를 나중에 부른다. 반대면 몬스터가 스폰되는 순간 플레이어가 옛 match에 있어 옵저버에서 빠지고, 서버에만 있는 &quot;유령 몬스터&quot;가 된다.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="918" width="640" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="&lt;b style=&quot;font-size:13px&quot;&gt;설계 메모 2 — matchId의 한계&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;matchId는 네트워크 가시성만 나눈다. 물리 세계는 하나라 방끼리 몬스터가 같은 좌표에 겹친다. 데미지 · 어그로 격리는 별도로 넣었다.&lt;br&gt;씬 전환 완료는 고정 타이머가 아니라 ACK로 확인한다 (기기별 로드 시간 편차가 큼).&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="918" width="640" height="99" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. AI NPC 파이프라인" id="page4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
