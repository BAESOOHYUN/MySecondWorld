        <mxCell id="c32" edge="1" parent="1" source="c28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c27" value="ISkill.Execute(SkillContext)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" edge="1" parent="1" source="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c24" value="실행 순서">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c34" edge="1" parent="1" source="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c25" value="실행 순서">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c35" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;피격 대상&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;IDamageable · Health&lt;br&gt;CombatFaction: 아군오사 방지 · 어그로 조건&lt;br&gt;IStunnable: 피격 경직 · 기절 등 일시적 행동 제어&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="420" x="1200" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c36" edge="1" parent="1" source="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c35" value="피해 적용">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c37" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;규칙&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;호출하는 쪽은 ISkill만 안다. 어떤 에셋이 끼었는지는 모른다.&lt;br&gt;투사체는 도착해야 대상이 정해지므로 ①이 먼저다.&lt;br&gt;슬롯의 SO는 전역 단일 인스턴스라 무상태여야 한다. 캐스터별 값은 SkillContext로 넘긴다.&lt;br&gt;몬스터는 AI가 ISkillSelector로 스킬 번호를 고르고 애니메이션을 재생하면, 타격 프레임의 애니메이션 이벤트로 Hitbox가 Execute를 부른다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="165" width="420" x="1200" y="529" as="geometry" />
        </mxCell>
        <mxCell id="c38" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" value="B. 서버 권위 공격 — 클라가 보낸 값을 믿지 않는다" vertex="1">
          <mxGeometry height="31" width="900" x="40" y="862" as="geometry" />
        </mxCell>
        <mxCell id="c39" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;클라: PlayerAttackController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;입력 · 홀드 게이지 연출 · 애니메이션&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="340" x="40" y="912" as="geometry" />
        </mxCell>
        <mxCell id="c40" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;서버: PlayerAttackAuthority  [NetworkBehaviour]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CmdResolveAttackHit (근접)&lt;br&gt;CmdRequestShoot (원거리)&lt;br&gt;CmdBeginAim / CmdEndAim (조준)&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="420" x="620" y="912" as="geometry" />
        </mxCell>
        <mxCell id="c41" edge="1" parent="1" source="c39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" target="c40" value="[Command] 요청 (클라 → 서버)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c42" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" value="서버가 직접 정하거나 검증하는 값" vertex="1">
          <mxGeometry height="24" width="700" x="40" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="c43" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;공격력&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;서버가 장착 무기에서 조회. 클라 값은 무시&lt;br&gt;코드: GetMainHandAttack()&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="300" x="40" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="c44" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;충돌 마스크&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;서버 상수로 고정. 클라 입력을 안 받음&lt;br&gt;코드: MonsterLayerMask&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="300" x="360" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="c45" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;공격 위치 · 발사 원점&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;내 캐릭터와의 거리로 검증 (4m 초과 시 무시)&lt;br&gt;코드: MaxAttackReach&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="300" x="680" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="c46" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;쿨다운&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;서버 시계로 따로 측정 (클라보다 10% 느슨)&lt;br&gt;코드: _serverNextShootTime&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="300" x="1000" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="c47" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;조준 게이지&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;서버가 홀드 시간 · 이동 여부를 직접 측정&lt;br&gt;코드: _aimGaugeServer&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="300" x="1320" y="1071" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" value="C. 근접 공격 파이프라인 — 클라가 &quot;쳤다&quot;고 알리면, 서버가 범위를 직접 훑어 판정한다" vertex="1">
          <mxGeometry height="31" width="1500" x="40" y="1213" as="geometry" />
        </mxCell>
        <mxCell id="c49" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;PlayerAttackController&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;OnAttackHit(): 공격 애니메이션의 타격 프레임에 애니메이션 이벤트로 호출&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="340" x="60" y="1313" as="geometry" />
        </mxCell>
        <mxCell id="c51" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;PlayerAttackAuthority&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CmdResolveAttackHit(): [Command]로 받는다. 위치는 4m 이내인지 검증하고, 공격력은 서버가 직접 조회한다.&lt;br&gt;클라가 노린 대상(netId)은 공격 범위(구) 안에 있을 때만 우선 적용&lt;/span&gt;" vertex="1">
          <mxGeometry height="132" width="280" x="60" y="1547" as="geometry" />
        </mxCell>
        <mxCell id="c52" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;SphereAttackResolver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ResolveAndExecute(): OverlapSphere로 공격 범위 안의 후보를 찾아 SkillContext를 만든다&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="280" x="380" y="1547" as="geometry" />
        </mxCell>
        <mxCell id="c53" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;SkillDefinition :&amp;nbsp;&lt;/b&gt;ISkill&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Execute(): _meleeSkill 실행 (축 구성은 스킬 에셋에 따름)&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="280" x="700" y="1547" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;IDamageable (Health)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;피해 적용&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="280" x="1020" y="1547" as="geometry" />
        </mxCell>
        <mxCell id="c55" edge="1" parent="1" source="c51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" target="c52" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c56" edge="1" parent="1" source="c52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" target="c53" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c59" edge="1" parent="1" source="c49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" target="c51" value="[Command]&lt;br&gt;CmdResolveAttackHit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c60" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;OverlapSphere란&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Unity 물리 함수 Physics.OverlapSphere.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size:12px&quot;&gt;중심점과 반경을 주면 그 점을 중심으로 한 공 모양(구) 범위를 만들고, 그 안에 닿아 있는 콜라이더를 한꺼번에 모아 준다.&lt;br&gt;근접 공격의 &quot;타격 범위&quot;를 이렇게 판정한다. 총알처럼 날아가는 게 아니라, 타격 순간에 그 범위 안에 누가 있는지 한 번 확인하는 방식이다. 지정한 레이어만 보고, 트리거 콜라이더는 무시한다.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="790" x="40" y="1729" as="geometry" />
        </mxCell>
        <mxCell id="c61" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=4;fontSize=12;" value="&lt;b style=&quot;font-size:13px&quot;&gt;SphereAttackResolver는 공용 부품&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;플레이어(PlayerAttackAuthority) · 몬스터(MonsterHitbox) · 컴패니언(CompanionHitbox) · 보스 범위 공격(BossAoEHitbox)이 모두 같은 클래스로 판정한다. 범위 판정과 SkillContext 구성이 한 곳에 있다.&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="790" x="870" y="1729" as="geometry" />
        </mxCell>
        <mxCell id="c62" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" value="D. 원거리 투사체 파이프라인 — 서버가 판정하고, 클라는 보여 주기만 한다" vertex="1">
          <mxGeometry height="31" width="1500" x="40" y="1904" as="geometry" />
        </mxCell>
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
