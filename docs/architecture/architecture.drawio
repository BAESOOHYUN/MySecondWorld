        <mxCell id="c60" edge="1" parent="1" source="c58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#B85450;fontColor=#B85450;" target="c59" value="필요한 참조 ✗&lt;br&gt;Network → Combat">
